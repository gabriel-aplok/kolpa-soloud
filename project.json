{
	"schemaVersion": 1,
	"name": "soloud",
	"type": "cpp-native",
	"configurations": {
		"debug": {
			"defines": [
				"_DEBUG"
			],
			"compileOptions": []
		},
		"release": {
			"defines": [
				"NDEBUG"
			],
			"compileOptions": []
		}
	},
	"paths": {
		"build": "build",
		"include": [
			"src"
		]
	},
	"targets": [
		{
			"name": "lib",
			"type": "static",
			"source": [
				"src"
			],
			"defines": [
				"WITH_MINIAUDIO",
				"WITH_NULL"
			],
			"compileOptions": [
				"-std=c++17",
				"-Wall",
				"-Wno-unused-parameter"
			],
			"output": "libsoloud.a"
		},
		{
			"name": "mix-benchmark",
			"type": "exe",
			"language": "c++",
			"sources": [
				"benchmarks/mix.cpp"
			],
			"libraries": [
				"soloud"
			],
			"libraryPaths": [
				"build/${config}/bin"
			],
			"linkOptions": [
				"-lm"
			],
			"compileOptions": [
				"-std=c++17",
				"-Wall"
			],
			"output": "soloud_mix_benchmark.exe"
		},
		{
			"name": "smoke",
			"type": "test",
			"language": "c++",
			"sources": [
				"tests/smoke.cpp"
			],
			"libraries": [
				"soloud"
			],
			"libraryPaths": [
				"build/${config}/bin"
			],
			"linkOptions": [
				"-lm"
			],
			"compileOptions": [
				"-std=c++17",
				"-Wall"
			],
			"output": "soloud_smoke.exe"
		},
		{
			"name": "miniaudio-device-smoke",
			"type": "exe",
			"language": "c++",
			"sources": [
				"tests/miniaudio_device_smoke.cpp"
			],
			"libraries": [
				"soloud"
			],
			"libraryPaths": [
				"build/${config}/bin"
			],
			"linkOptions": [
				"-lm"
			],
			"compileOptions": [
				"-std=c++17",
				"-Wall"
			],
			"output": "soloud_miniaudio_device_smoke.exe"
		},
		{
			"name": "miniaudio-recovery-policy",
			"type": "test",
			"language": "c++",
			"sources": [
				"tests/miniaudio_recovery_policy.cpp"
			],
			"libraries": [],
			"libraryPaths": [],
			"linkOptions": [],
			"compileOptions": [
				"-std=c++17",
				"-Wall"
			],
			"output": "soloud_miniaudio_recovery_policy.exe"
		}
	]
}
